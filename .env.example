# ==============================================================================
# KhattGPT / Waraka — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# In production (Vercel / Coolify), set these variables in the dashboard.
# NEVER commit your real secrets (.env.local, .env.production) to Git.
# ==============================================================================

# Public Supabase Client Config (accessible from both browser and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# Server-Side Supabase Service Role Key (NEVER expose to client - admin operations only)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Comma-separated list of administrative email addresses authorized for /admin
ADMIN_EMAILS=admin@example.com

# Cryptographic salt phrase used to hash sensitive identifiers in research exports
EXPORT_SALT=change_me_to_a_secure_random_salt_for_research_exports
